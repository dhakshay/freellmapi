# Copy to .env and export these before `npm start`, or set them in your host's dashboard. Never commit real values.
PORT=3000
DB_PATH=frame-in.db
BASE_URL=https://your-domain.example      # used in emails, sitemap and robots.txt
TRUST_PROXY=true                          # set when running behind a proxy or host load balancer

# Store details shown on the policy and contact pages
STORE_NAME=Frame In
SUPPORT_EMAIL=help@your-domain.example
SUPPORT_PHONE=
STORE_ADDRESS=
RETURN_DAYS=7

# Admin screen at /admin.html (leave empty to disable)
ADMIN_TOKEN=

# Online payments (Razorpay). Use test keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Order emails (optional). Any SMTP provider works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ORDER_ALERT_EMAIL=                        # also email the owner on each new order
